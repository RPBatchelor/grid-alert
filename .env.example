# Copy to .env and fill in. Never commit .env.

# Cloudflare Tunnel token (Cloudflare Zero Trust → Networks → Tunnels → your tunnel → install
# command: the long string after "--token"). See DEPLOY.md step 7b.
TUNNEL_TOKEN=

# ---- Sign-in -------------------------------------------------------------------------------
# The first admin account is created from these on start-up (only if no admin exists yet).
# After your first sign-in you can blank ADMIN_PASSWORD; it is not used again.
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PASSWORD=

# Where access requests are emailed (comma-separated). Defaults to every admin's email.
ADMIN_NOTIFY_EMAIL=

# Public address, used in emailed links.
APP_URL=https://grid-alert.com

# ---- Email (Resend, https://resend.com) ----------------------------------------------------
# API key with "Sending access" for grid-alert.com. Without it, emails are written to the app
# log instead (docker compose logs app | grep MAIL) and Settings → Users shows links to copy.
RESEND_API_KEY=
MAIL_FROM=Grid Alert Victoria <noreply@grid-alert.com>

# Minutes between outage snapshots for the historian (0 disables collection).
COLLECT_INTERVAL_MINUTES=5

# Optional, local development only: Windy Map Forecast API key for `npm run dev`. On the Pi,
# enter the key in the app instead (Settings → Integrations); it is stored per browser.
VITE_WINDY_KEY=
